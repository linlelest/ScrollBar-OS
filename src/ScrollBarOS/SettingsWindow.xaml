<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScrollBarOS.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel Spacing="16">

            <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" />

            <!-- 1. Capsule Position -->
            <StackPanel Spacing="8">
                <TextBlock Text="Capsule Position" FontSize="14" FontWeight="SemiBold" />
                <ComboBox x:Name="PositionCombo" HorizontalAlignment="Stretch" SelectionChanged="PositionCombo_SelectionChanged">
                    <ComboBoxItem Content="Left" Tag="Left" />
                    <ComboBoxItem Content="Right" Tag="Right" />
                </ComboBox>
            </StackPanel>

            <!-- 2. Background Material -->
            <StackPanel Spacing="8">
                <TextBlock Text="Background Material" FontSize="14" FontWeight="SemiBold" />
                <ComboBox x:Name="MaterialCombo" HorizontalAlignment="Stretch" SelectionChanged="MaterialCombo_SelectionChanged">
                    <ComboBoxItem Content="Solid" />
                    <ComboBoxItem Content="Acrylic" />
                    <ComboBoxItem Content="Mica" />
                </ComboBox>
            </StackPanel>

            <!-- 3. Opacity -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="OpacityLabel" Text="Opacity:" FontSize="14" FontWeight="SemiBold" />
                <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" StepFrequency="5" ValueChanged="OpacitySlider_ValueChanged" />
            </StackPanel>

            <!-- 4. Capsule Width -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="WidthLabel" Text="Capsule Width:" FontSize="14" FontWeight="SemiBold" />
                <Slider x:Name="WidthSlider" Minimum="48" Maximum="96" StepFrequency="4" ValueChanged="WidthSlider_ValueChanged" />
            </StackPanel>

            <!-- 5. Icon Size -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="IconLabel" Text="Icon Size:" FontSize="14" FontWeight="SemiBold" />
                <Slider x:Name="IconSlider" Minimum="24" Maximum="48" StepFrequency="4" ValueChanged="IconSlider_ValueChanged" />
            </StackPanel>

            <!-- 6. Widgets -->
            <StackPanel Spacing="8">
                <TextBlock Text="Widgets" FontSize="14" FontWeight="SemiBold" />
                <ToggleSwitch x:Name="HwToggle" Header="Hardware Monitor" Toggled="HwToggle_Toggled" />
                <ToggleSwitch x:Name="DtToggle" Header="Date &amp; Time" Toggled="DtToggle_Toggled" />
            </StackPanel>

            <!-- 7. System -->
            <StackPanel Spacing="8">
                <TextBlock Text="System" FontSize="14" FontWeight="SemiBold" />
                <ToggleSwitch x:Name="TaskbarToggle" Header="Hide Taskbar" Toggled="TaskbarToggle_Toggled" />
                <ToggleSwitch x:Name="StartupToggle" Header="Start with Windows" Toggled="StartupToggle_Toggled" />
            </StackPanel>

            <!-- 8. Language -->
            <StackPanel Spacing="8">
                <TextBlock Text="Language" FontSize="14" FontWeight="SemiBold" />
                <ComboBox x:Name="LangCombo" HorizontalAlignment="Stretch" SelectionChanged="LangCombo_SelectionChanged">
                    <ComboBoxItem Content="简体中文" />
                    <ComboBoxItem Content="English" />
                </ComboBox>
            </StackPanel>

            <TextBlock Text="ScrollBar OS v1.0.0" FontSize="11" Opacity="0.5" Margin="0,16,0,0" />

        </StackPanel>
    </ScrollViewer>

</Window>
