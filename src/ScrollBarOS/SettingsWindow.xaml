<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScrollBarOS.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d">

    <Window.Resources>
        <!-- DPI-aware styles -->
        <Style x:Key="DpiAwareTextBlock" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <Style x:Key="DpiAwareComboBox" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        
        <Style x:Key="DpiAwareSlider" TargetType="Slider">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        
        <Style x:Key="DpiAwareToggleSwitch" TargetType="ToggleSwitch">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />

            <!-- Capsule Position -->
            <TextBlock Text="Capsule Position" Style="{StaticResource DpiAwareTextBlock}" />
            <ComboBox x:Name="PositionComboBox" Style="{StaticResource DpiAwareComboBox}">
                <ComboBoxItem Content="Left" />
                <ComboBoxItem Content="Right" />
            </ComboBox>

            <!-- Background Material -->
            <TextBlock Text="Background Material" Style="{StaticResource DpiAwareTextBlock}" />
            <ComboBox x:Name="MaterialComboBox" Style="{StaticResource DpiAwareComboBox}">
                <ComboBoxItem Content="Solid" />
                <ComboBoxItem Content="Acrylic" />
                <ComboBoxItem Content="Mica" />
            </ComboBox>

            <!-- Opacity -->
            <TextBlock x:Name="OpacityLabel" Text="Opacity: 100%" Style="{StaticResource DpiAwareTextBlock}" />
            <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" Value="100" StepFrequency="5" Style="{StaticResource DpiAwareSlider}" />

            <!-- Capsule Width -->
            <TextBlock x:Name="WidthLabel" Text="Capsule Width: 64px" Style="{StaticResource DpiAwareTextBlock}" />
            <Slider x:Name="WidthSlider" Minimum="48" Maximum="96" Value="64" StepFrequency="4" Style="{StaticResource DpiAwareSlider}" />

            <!-- Icon Size -->
            <TextBlock x:Name="IconSizeLabel" Text="Icon Size: 32px" Style="{StaticResource DpiAwareTextBlock}" />
            <Slider x:Name="IconSizeSlider" Minimum="24" Maximum="48" Value="32" StepFrequency="4" Style="{StaticResource DpiAwareSlider}" />

            <!-- Widgets -->
            <TextBlock Text="Widgets" Style="{StaticResource DpiAwareTextBlock}" />
            <ToggleSwitch x:Name="HardwareWidgetToggle" Header="Hardware Monitor" Style="{StaticResource DpiAwareToggleSwitch}" />
            <ToggleSwitch x:Name="DateTimeWidgetToggle" Header="Date &amp; Time" Style="{StaticResource DpiAwareToggleSwitch}" />

            <!-- System -->
            <TextBlock Text="System" Style="{StaticResource DpiAwareTextBlock}" />
            <ToggleSwitch x:Name="HideTaskbarToggle" Header="Hide Taskbar" Style="{StaticResource DpiAwareToggleSwitch}" />
            <ToggleSwitch x:Name="StartupToggle" Header="Start with Windows" Style="{StaticResource DpiAwareToggleSwitch}" />

            <!-- Version -->
            <TextBlock Text="ScrollBar OS v1.0.0" FontSize="11" Opacity="0.5" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>