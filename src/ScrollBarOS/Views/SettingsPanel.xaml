<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ScrollBarOS.Views.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="SettingsRoot"
          Visibility="Collapsed">
        
        <!-- Backdrop -->
        <Rectangle Fill="#44000000" Tapped="Backdrop_Tapped"/>
        
        <!-- Settings Panel -->
        <Border x:Name="SettingsBorder"
                Background="#F21E1E2E"
                CornerRadius="12"
                Width="320"
                MaxHeight="560"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,80,0"
                Padding="20">
            
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <!-- Header -->
                    <Grid>
                        <TextBlock Text="Settings"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"/>
                        <Button x:Name="CloseButton"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4"
                                Click="CloseButton_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#AAFFFFFF"/>
                        </Button>
                    </Grid>

                    <!-- 1. Background Color & Material -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Capsule Background" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        
                        <ComboBox x:Name="MaterialCombo"
                                  Header="Material"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="MaterialCombo_SelectionChanged">
                            <ComboBoxItem Content="Solid" Tag="Solid"/>
                            <ComboBoxItem Content="Gradient" Tag="Gradient"/>
                            <ComboBoxItem Content="Mica" Tag="Mica"/>
                            <ComboBoxItem Content="Acrylic" Tag="Acrylic" IsSelected="True"/>
                        </ComboBox>

                        <Slider x:Name="OpacitySlider"
                                Header="Opacity"
                                Minimum="0.2" Maximum="1.0" StepFrequency="0.05"
                                Value="0.8"
                                ValueChanged="OpacitySlider_ValueChanged"/>
                    </StackPanel>

                    <!-- 2. Capsule Position -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Capsule Position" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        <RadioButtons x:Name="PositionRadio"
                                      SelectedIndex="1"
                                      SelectionChanged="PositionRadio_SelectionChanged">
                            <RadioButton Content="Left" Tag="Left"/>
                            <RadioButton Content="Right" Tag="Right" IsChecked="True"/>
                        </RadioButtons>
                    </StackPanel>

                    <!-- 3. Widgets -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Widgets" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        
                        <ToggleSwitch x:Name="DateTimeToggle"
                                      Header="Date &amp; Time"
                                      IsOn="False"
                                      Toggled="DateTimeToggle_Toggled"/>
                        
                        <ToggleSwitch x:Name="HardwareToggle"
                                      Header="Hardware Monitor"
                                      IsOn="True"
                                      Toggled="HardwareToggle_Toggled"/>
                    </StackPanel>

                    <!-- 4. Taskbar -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="System" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        
                        <ToggleSwitch x:Name="TaskbarToggle"
                                      Header="Hide Taskbar"
                                      IsOn="False"
                                      Toggled="TaskbarToggle_Toggled"/>
                        
                        <ToggleSwitch x:Name="StartupToggle"
                                      Header="Start with Windows"
                                      IsOn="False"
                                      Toggled="StartupToggle_Toggled"/>
                    </StackPanel>

                    <!-- 5. Language -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Language" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        <ComboBox x:Name="LanguageCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="0"
                                  SelectionChanged="LanguageCombo_SelectionChanged">
                            <ComboBoxItem Content="简体中文" Tag="Chinese"/>
                            <ComboBoxItem Content="English" Tag="English"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- 6. Size -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Size" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        
                        <Slider x:Name="CapsuleWidthSlider"
                                Header="Capsule Width"
                                Minimum="48" Maximum="96" StepFrequency="4"
                                Value="64"
                                ValueChanged="CapsuleWidthSlider_ValueChanged"/>
                        
                        <Slider x:Name="IconSizeSlider"
                                Header="Icon Size"
                                Minimum="24" Maximum="48" StepFrequency="4"
                                Value="36"
                                ValueChanged="IconSizeSlider_ValueChanged"/>
                    </StackPanel>

                    <!-- About -->
                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="ScrollBar OS v1.0.0" FontSize="11" Foreground="#88FFFFFF"/>
                        <TextBlock Text="Lightweight Windows Desktop Enhancement" FontSize="10" Foreground="#66FFFFFF"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
