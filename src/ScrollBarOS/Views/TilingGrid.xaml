<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ScrollBarOS.Views.TilingGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="TilingRoot"
          Background="#88000000"
          Visibility="Collapsed">
        
        <!-- Semi-transparent Mica-like background -->
        <Border Background="#AA1E1E2E"
                CornerRadius="16"
                Margin="80"
                Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0"
                           Text="Window Tiling"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           Margin="0,0,0,16"/>

                <!-- Grid Area -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsRepeater x:Name="TilingItemsRepeater">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="120"
                                               MinItemHeight="90"
                                               MinColumnSpacing="12"
                                               MinRowSpacing="12"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8"
                                        Background="#44FFFFFF"
                                        BorderBrush="#66FFFFFF"
                                        BorderThickness="1"
                                        Padding="8"
                                        AllowDrop="True">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="6">
                                        <Image Source="{Binding Icon}"
                                               Width="32" Height="32"
                                               HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="10"
                                                   Foreground="#CCFFFFFF"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="12"
                            Margin="0,16,0,0">
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Click="CancelButton_Click"
                            Background="#44FFFFFF"
                            Foreground="#FFFFFF"
                            Padding="16,8"/>
                    <Button x:Name="ApplyButton"
                            Content="Apply Tiling"
                            Click="ApplyButton_Click"
                            Background="#4CC2FF"
                            Foreground="#FFFFFF"
                            Padding="16,8"
                            CornerRadius="6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
