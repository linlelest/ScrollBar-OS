<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ScrollBarOS.Views.CapsuleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="CapsuleRoot" 
          CornerRadius="20"
          Background="#CC1E1E2E"
          PointerEntered="CapsuleRoot_PointerEntered"
          PointerExited="CapsuleRoot_PointerExited"
          PointerWheelChanged="CapsuleRoot_PointerWheelChanged">

        <Grid.RowDefinitions>
            <!-- Scrollable app icons area (70%) -->
            <RowDefinition Height="7*"/>
            <!-- Fixed bottom area (30%) -->
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <!-- App Icons Scroll Area -->
        <ScrollViewer x:Name="IconScrollViewer"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,12,0,8">
            <ItemsRepeater x:Name="AppIconsRepeater"
                           HorizontalAlignment="Center">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="8"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="44" Height="44"
                              PointerPressed="AppIcon_PointerPressed"
                              PointerEntered="AppIcon_PointerEntered"
                              PointerExited="AppIcon_PointerExited"
                              RightTapped="AppIcon_RightTapped">
                            <Border CornerRadius="8"
                                    Background="#33FFFFFF"
                                    Padding="4">
                                <Image Source="{Binding Icon}"
                                       Width="36" Height="36"
                                       Stretch="Uniform"/>
                            </Border>
                            <!-- Tooltip -->
                            <ToolTipService.ToolTip>
                                <ToolTip Content="{Binding Title}"/>
                            </ToolTipService.ToolTip>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Bottom Fixed Area -->
        <Grid Grid.Row="1" Padding="0,4,0,8">
            <Grid.RowDefinitions>
                <!-- Mini widgets area -->
                <RowDefinition Height="Auto"/>
                <!-- 3 micro pinned apps -->
                <RowDefinition Height="Auto"/>
                <!-- Settings button -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Hardware/DateTime Widget Area -->
            <StackPanel x:Name="WidgetArea" 
                        Grid.Row="0" 
                        HorizontalAlignment="Center"
                        Margin="0,0,0,6">
                <!-- Hardware Info Button -->
                <Button x:Name="HardwareButton"
                        Width="32" Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Center"
                        PointerEntered="HardwareButton_PointerEntered"
                        PointerExited="HardwareButton_PointerExited"
                        Click="HardwareButton_Click">
                    <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="#AAFFFFFF"/>
                </Button>

                <!-- DateTime Display -->
                <TextBlock x:Name="DateTimeText"
                           FontSize="9"
                           Foreground="#AAFFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- 3 Micro Pinned Apps -->
            <StackPanel x:Name="PinnedAppsArea"
                        Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="4"
                        Margin="0,0,0,6">
                <Button x:Name="PinnedApp1" Width="20" Height="20" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="PinnedApp_Click" Tag="0">
                    <FontIcon Glyph="&#xE713;" FontSize="10" Foreground="#88FFFFFF"/>
                </Button>
                <Button x:Name="PinnedApp2" Width="20" Height="20" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="PinnedApp_Click" Tag="1">
                    <FontIcon Glyph="&#xE713;" FontSize="10" Foreground="#88FFFFFF"/>
                </Button>
                <Button x:Name="PinnedApp3" Width="20" Height="20" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="PinnedApp_Click" Tag="2">
                    <FontIcon Glyph="&#xE713;" FontSize="10" Foreground="#88FFFFFF"/>
                </Button>
            </StackPanel>

            <!-- Settings Button (anchored at bottom) -->
            <Button x:Name="SettingsButton"
                    Grid.Row="2"
                    Width="24" Height="24"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Center"
                    Click="SettingsButton_Click">
                <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="#CCFFFFFF"/>
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="OpenSettingsItem" Text="Settings" Click="SettingsButton_Click"/>
                        <MenuFlyoutItem x:Name="OpenTilingItem" Text="Window Tiling" Click="TilingMenuItem_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Name="ExitItem" Text="Exit" Click="ExitMenuItem_Click"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Hardware Popup -->
        <Popup x:Name="HardwarePopup" 
               IsLightDismissEnabled="True"
               HorizontalOffset="-180">
            <Border Background="#EE1E1E2E" 
                    CornerRadius="12" 
                    Padding="12"
                    Width="170">
                <StackPanel Spacing="8">
                    <TextBlock Text="System Monitor" FontSize="11" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                    
                    <!-- CPU -->
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="CpuLabel" Text="CPU: 0%" FontSize="10" Foreground="#AAFFFFFF"/>
                        <ProgressBar x:Name="CpuBar" Height="4" Value="0" Maximum="100" 
                                     Foreground="#4CC2FF" Background="#33FFFFFF"/>
                    </StackPanel>
                    
                    <!-- Memory -->
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="MemLabel" Text="RAM: 0%" FontSize="10" Foreground="#AAFFFFFF"/>
                        <ProgressBar x:Name="MemBar" Height="4" Value="0" Maximum="100"
                                     Foreground="#6CCB5F" Background="#33FFFFFF"/>
                    </StackPanel>
                    
                    <!-- Disk -->
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="DiskLabel" Text="Disk: 0%" FontSize="10" Foreground="#AAFFFFFF"/>
                        <ProgressBar x:Name="DiskBar" Height="4" Value="0" Maximum="100"
                                     Foreground="#F8B84E" Background="#33FFFFFF"/>
                    </StackPanel>
                    
                    <!-- Network -->
                    <TextBlock x:Name="NetLabel" Text="Net: ↑0 ↓0 KB/s" FontSize="10" Foreground="#AAFFFFFF"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
