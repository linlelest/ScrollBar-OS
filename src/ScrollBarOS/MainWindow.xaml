<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScrollBarOS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ScrollBarOS.Views">

    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- Capsule Control -->
        <views:CapsuleControl x:Name="Capsule" />

        <!-- Tiling Grid Overlay (manages own visibility) -->
        <views:TilingGrid x:Name="TilingGridOverlay" />

        <!-- Window List Overlay for fast scroll (manages own visibility) -->
        <views:WindowListOverlay x:Name="WindowListOverlay" />

        <!-- Settings Panel (manages own visibility) -->
        <views:SettingsPanel x:Name="SettingsPanel" />

        <!-- Tray Menu (manages own visibility) -->
        <views:TrayMenu x:Name="TrayMenu" />
    </Grid>
</Window>
