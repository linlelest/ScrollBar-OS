<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScrollBarOS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="RootBorder" Background="#CC1E1E2E" CornerRadius="20" Padding="8">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="7*"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>

            <!-- App Icons Area -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="AppIconsPanel" HorizontalAlignment="Center" Margin="0,12,0,8"/>
            </ScrollViewer>

            <!-- Bottom Area -->
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                <!-- Hardware Info -->
                <TextBlock x:Name="CpuText" Text="CPU: --" FontSize="9" Foreground="#AAFFFFFF" HorizontalAlignment="Center" Margin="0,2"/>
                <TextBlock x:Name="MemText" Text="RAM: --" FontSize="9" Foreground="#AAFFFFFF" HorizontalAlignment="Center" Margin="0,2"/>
                <!-- Settings Button -->
                <Button x:Name="SettingsButton" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="4" Margin="0,4,0,0" Click="SettingsButton_Click">
                    <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="#CCFFFFFF"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
